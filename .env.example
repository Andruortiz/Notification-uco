APP_PORT=8060

# Imagen publicada del servicio. Se usa con "docker compose --profile app up -d" (perfil app); sin el
# perfil, docker compose solo levanta las dependencias. Fija una version publicada, no uses develop.
NOTIFICATION_IMAGE=ghcr.io/andruortiz/notification-uco
NOTIFICATION_VERSION=develop

# Puerto de gestion (sondas de salud y metricas de Prometheus). No se publica fuera del cluster.
MANAGEMENT_PORT=8061

# Secreto de firma del JWT interino (HU2-096). Obligatorio y de al menos 32 bytes; sin valor por defecto.
# Genera uno con: openssl rand -base64 48
# Para desarrollo sin un secreto propio, activa el perfil local con SPRING_PROFILES_ACTIVE=local.
AUTH_JWT_HS256_SECRET=
#SPRING_PROFILES_ACTIVE=local
AUTH_JWT_TTL_MINUTES=720

# Modo de autenticacion: local (secreto compartido, por defecto) o platform (plataforma central de
# seguridad, validada con su clave publica). Ver "Autenticacion" en el README.
#NOTIFICATION_AUTH_MODE=local
#AUTH_PLATFORM_PUBLIC_KEY=
#AUTH_PLATFORM_ISSUER=
#AUTH_PLATFORM_AUDIENCE=
#AUTH_PLATFORM_SUBJECT_CLAIM=sub
#AUTH_PLATFORM_TENANT_CLAIM=tenantId
#AUTH_PLATFORM_ROLE_CLAIM=role

MONGO_HOST=localhost
MONGO_PORT=27018
MONGO_DATABASE=notification
MONGO_USERNAME=notification
MONGO_PASSWORD=notification

RABBITMQ_HOST=localhost
RABBITMQ_PORT=5673
RABBITMQ_MANAGEMENT_PORT=15673
RABBITMQ_USERNAME=notification
RABBITMQ_PASSWORD=notification

SIMULATED_PROVIDER_RESULT=ACCEPTED

BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=

MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ACCESS_KEY=notification
MINIO_SECRET_KEY=notification-secret
MINIO_ENDPOINT=http://localhost:9000
MINIO_PUBLIC_ENDPOINT=http://localhost:9000
# Origen(es) del frontend que pueden subir archivos directo a MinIO desde el navegador (separados por coma).
MINIO_CORS_ALLOW_ORIGIN=http://localhost:5173

CLAMAV_HOST=localhost
CLAMAV_PORT=3310

# Proveedores del canal EMAIL en orden de preferencia; el despacho usa el primero. Para entregar
# correos reales (y adjuntos) con Brevo: NOTIFICATION_EMAIL_PROVIDERS=brevo y las variables BREVO_*.
# Por defecto va primero el simulado, que no envia nada.
#NOTIFICATION_EMAIL_PROVIDERS=brevo

# SMS con Twilio. Una cuenta de prueba solo envia a numeros verificados y solo acepta nombres de
# plantilla predefinidos en el body. Por defecto va primero el simulado.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
#NOTIFICATION_SMS_PROVIDERS=twilio

# Push con Firebase Cloud Messaging. Define una de las dos: la ruta del JSON de la cuenta de servicio
# (fuera del repositorio) o su contenido como texto. Por defecto va primero el simulado.
FCM_CREDENTIALS_FILE=
FCM_CREDENTIALS_JSON=
#NOTIFICATION_PUSH_PROVIDERS=fcm

# Componente de Parametros (opcional). Vacio = no se consulta y se opera con la configuracion local o
# con la ultima configuracion valida guardada en Mongo.
NOTIFICATION_PARAMETERS_BASE_URL=
#NOTIFICATION_PARAMETERS_POLL_INTERVAL_MS=30000
#NOTIFICATION_PARAMETERS_TIMEOUT_MS=5000
#NOTIFICATION_PARAMETERS_CONNECT_TIMEOUT_MS=2000
#NOTIFICATION_PARAMETERS_LAST_KNOWN_LOAD_TIMEOUT_MS=5000

# Azure Key Vault (opcional). Vacio = solo se usa este .env. Si se define, los secretos del vault
# se cargan como variables de entorno: el secreto MONGO-PASSWORD se lee como MONGO_PASSWORD.
# Una variable de entorno real siempre prevalece sobre el vault. Autenticacion: identidad
# administrada en Azure (o `az login` en local). Ver "Azure Key Vault" en el README.
AZURE_KEYVAULT_ENDPOINT=
# Opcional. Si se define (por ejemplo NOTIFICATION-), solo se leen los secretos del vault cuyo nombre
# empieza con ese prefijo, y el prefijo se descarta: NOTIFICATION-MONGO-PASSWORD -> MONGO_PASSWORD.
# Vacio = se leen todos los secretos del vault.
AZURE_KEYVAULT_SECRET_PREFIX=

# Tablero de observabilidad (docker-compose.observability.yml). Obligatorias solo si incluyes ese
# archivo; sin valor por defecto. Define el usuario y una contrasena propios.
GRAFANA_ADMIN_USER=
GRAFANA_ADMIN_PASSWORD=
#GRAFANA_PORT=3000
#PROMETHEUS_PORT=9090
# Para levantar el stack con "docker compose up -d" sin repetir -f (en Windows el separador por
# defecto es ";", asi que fijalo a coma):
#COMPOSE_PATH_SEPARATOR=,
#COMPOSE_FILE=docker-compose.yml,docker-compose.observability.yml
