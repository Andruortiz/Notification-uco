APP_PORT=8060

# Imagen publicada del servicio. Se usa con "docker compose --profile app up -d" (perfil app); sin el
# perfil, docker compose solo levanta las dependencias. Fija una version publicada, no uses develop.
NOTIFICATION_IMAGE=ghcr.io/andruortiz/notification-uco
NOTIFICATION_VERSION=latest

# Puerto de gestion (sondas de salud y metricas de Prometheus). No se publica fuera del cluster.
MANAGEMENT_PORT=8061

# Clave publica de la plataforma de seguridad (RSA o EC, X.509, PEM o Base64). Obligatoria siempre: el servicio no arranca sin ella.
# Para desarrollo local genera un par de claves y un token con: pwsh scripts/dev-token.ps1
AUTH_PLATFORM_PUBLIC_KEY=
#AUTH_PLATFORM_ISSUER=
#AUTH_PLATFORM_AUDIENCE=
#AUTH_PLATFORM_SUBJECT_CLAIM=sub
#AUTH_PLATFORM_TENANT_CLAIM=tenantId
#AUTH_PLATFORM_ROLE_CLAIM=role
#AUTH_PLATFORM_CLIENT_CLAIM=azp
#SPRING_PROFILES_ACTIVE=local

MONGO_HOST=localhost
MONGO_PORT=27018
MONGO_DATABASE=notification
MONGO_USERNAME=notification
MONGO_PASSWORD=notification

RABBITMQ_HOST=localhost
RABBITMQ_PORT=5673
RABBITMQ_MANAGEMENT_PORT=15673
RABBITMQ_USERNAME=notification
RABBITMQ_PASSWORD=notification

# SIMULATED_PROVIDER_ENABLED: solo true en local y pruebas. Con false (por defecto) el proveedor simulated no envia; en despliegues sin credenciales reales de Brevo/Twilio/FCM el despacho falla con ProviderDisabledException y el mensaje sigue el camino de reintento y DLQ.
SIMULATED_PROVIDER_ENABLED=false
SIMULATED_PROVIDER_RESULT=ACCEPTED

BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=
# BREVO_WEBHOOK_SECRET: secreto de la cabecera X-Brevo-Webhook-Secret del webhook de rebotes. Si SECURITY_PEP_PUBLIC_PATHS se define en el despliegue, debe incluir /providers/brevo/bounce-events o Brevo recibira 401 del PEP.
BREVO_WEBHOOK_SECRET=

MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ACCESS_KEY=notification
MINIO_SECRET_KEY=notification-secret
MINIO_ENDPOINT=http://localhost:9000
MINIO_PUBLIC_ENDPOINT=http://localhost:9000
# Origen(es) del frontend que pueden subir archivos directo a MinIO desde el navegador (separados por coma).
MINIO_CORS_ALLOW_ORIGIN=http://localhost:5173

CLAMAV_HOST=localhost
CLAMAV_PORT=3310

# Proveedores del canal EMAIL en orden de preferencia; el despacho usa el primero. Para entregar
# correos reales (y adjuntos) con Brevo: NOTIFICATION_EMAIL_PROVIDERS=brevo y las variables BREVO_*.
# Por defecto va primero el simulado, que no envia nada.
#NOTIFICATION_EMAIL_PROVIDERS=brevo

# SMS con Twilio. Una cuenta de prueba solo envia a numeros verificados y solo acepta nombres de
# plantilla predefinidos en el body. Por defecto va primero el simulado.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
#NOTIFICATION_SMS_PROVIDERS=twilio

# Push con Firebase Cloud Messaging. Define una de las dos: la ruta del JSON de la cuenta de servicio
# (fuera del repositorio) o su contenido como texto. Por defecto va primero el simulado.
FCM_CREDENTIALS_FILE=
FCM_CREDENTIALS_JSON=
#NOTIFICATION_PUSH_PROVIDERS=fcm

# Conmutacion entre proveedores (HU2-115). Un breaker por proveedor y canal: con la lista de
# proveedores del canal en orden de preferencia, si el primero falla o su breaker esta abierto el
# despacho pasa al siguiente. Valores por defecto mostrados.
#NOTIFICATION_PROVIDER_CIRCUIT_BREAKER_FAILURE_RATE_THRESHOLD=50
#NOTIFICATION_PROVIDER_CIRCUIT_BREAKER_MINIMUM_CALLS=5
#NOTIFICATION_PROVIDER_CIRCUIT_BREAKER_SLIDING_WINDOW_SIZE=10
#NOTIFICATION_PROVIDER_CIRCUIT_BREAKER_OPEN_WAIT=30s
#NOTIFICATION_PROVIDER_CIRCUIT_BREAKER_HALF_OPEN_CALLS=2

# Tiempo maximo de la prueba de conexion con un proveedor (POST /provider-connection-tests).
#NOTIFICATION_PROVIDER_PROBE_TIMEOUT=5s

# Registro de dispositivos push (HU2-120). Claves AES-256 en Base64 (32 bytes) para cifrar el token
# y calcular la huella; obligatorias salvo que todos los perfiles activos sean local o test. Genera
# cada una con: openssl rand -base64 32. Las versiones permiten rotar la clave sin perder lecturas.
DEVICE_TOKEN_KEY=
DEVICE_TOKEN_KEY_VERSION=1
DEVICE_FINGERPRINT_KEY=
DEVICE_FINGERPRINT_KEY_VERSION=1
#NOTIFICATION_DEVICES_RETENTION_DAYS=270
#NOTIFICATION_DEVICES_SWEEP_ENABLED=true
#NOTIFICATION_DEVICES_SWEEP_BATCH_SIZE=200

# Componente de Parametros (opcional). Vacio = no se consulta y se opera con la configuracion local o
# con la ultima configuracion valida guardada en Mongo.
NOTIFICATION_PARAMETERS_BASE_URL=
#NOTIFICATION_PARAMETERS_POLL_INTERVAL_MS=30000
#NOTIFICATION_PARAMETERS_TIMEOUT_MS=5000
#NOTIFICATION_PARAMETERS_CONNECT_TIMEOUT_MS=2000
#NOTIFICATION_PARAMETERS_LAST_KNOWN_LOAD_TIMEOUT_MS=5000

# Azure Key Vault (opcional). Vacio = solo se usa este .env. Si se define, los secretos del vault
# se cargan como variables de entorno: el secreto MONGO-PASSWORD se lee como MONGO_PASSWORD.
# Una variable de entorno real siempre prevalece sobre el vault. Autenticacion: identidad
# administrada en Azure (o `az login` en local). Ver "Azure Key Vault" en el README.
AZURE_KEYVAULT_ENDPOINT=
# Opcional. Si se define (por ejemplo NOTIFICATION-), solo se leen los secretos del vault cuyo nombre
# empieza con ese prefijo, y el prefijo se descarta: NOTIFICATION-MONGO-PASSWORD -> MONGO_PASSWORD.
# Vacio = se leen todos los secretos del vault.
AZURE_KEYVAULT_SECRET_PREFIX=

# Tablero de observabilidad (docker-compose.observability.yml). Obligatorias solo si incluyes ese
# archivo; sin valor por defecto. Define el usuario y una contrasena propios.
GRAFANA_ADMIN_USER=
GRAFANA_ADMIN_PASSWORD=
#GRAFANA_PORT=3000
#PROMETHEUS_PORT=9090
# Para levantar el stack con "docker compose up -d" sin repetir -f (en Windows el separador por
# defecto es ";", asi que fijalo a coma):
#COMPOSE_PATH_SEPARATOR=,
#COMPOSE_FILE=docker-compose.yml,docker-compose.observability.yml

# Panel de salud de proveedores (HU2-121): Prometheus del que lee GET /provider-health y URL base de Grafana.
#PROMETHEUS_URL=http://localhost:9090
#GRAFANA_URL=http://localhost:3000
#PROVIDER_HEALTH_WINDOW=5m
#PROVIDER_HEALTH_LOOKBACK=15m
#PROVIDER_HEALTH_TIMEOUT=2s
#PROVIDER_HEALTH_MIN_SAMPLES=5
#PROVIDER_HEALTH_HEALTHY_THRESHOLD=0.95
#PROVIDER_HEALTH_DOWN_THRESHOLD=0.5
#PROVIDER_HEALTH_RECOVERABLE_THRESHOLD=0.5

# Pruebas de carga medibles (HU2-122, carpeta loadtest/). Las lee el script de k6, no el servicio.
# Solo contra el proveedor simulado: LOADTEST_CONFIRM_SIMULATED debe ser true. Define LOADTEST_BEARER
# (JWT sin el prefijo Bearer) o LOADTEST_COOKIE; nunca los guardes en este archivo.
#LOADTEST_CONFIRM_SIMULATED=true
#LOADTEST_BEARER=
#LOADTEST_COOKIE=
#LOADTEST_BASE_URL=http://localhost:8060
#LOADTEST_ALLOW_REMOTE=false
#LOADTEST_RATE_PER_MINUTE=700
#LOADTEST_WINDOW_MINUTES=5
#LOADTEST_WARMUP_MINUTES=1
#LOADTEST_DRAIN_SECONDS=45
#LOADTEST_RESULT_FILE=resultado.json
