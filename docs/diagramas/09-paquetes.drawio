5555;strokeWidth=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p7" target="p9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p23" value="«use»" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;fontSize=10;strokeColor=#555555;strokeWidth=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p7" target="p10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p24" value="«use»" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;fontSize=10;strokeColor=#555555;strokeWidth=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p9" target="p11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p25" value="«use»" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;fontSize=10;strokeColor=#555555;strokeWidth=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p10" target="p12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p26" value="«use»" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;fontSize=10;strokeColor=#555555;strokeWidth=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p11" target="p12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p27" value="«use»" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;fontSize=10;strokeColor=#555555;strokeWidth=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p12" target="p13"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p28" value="«use»" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;fontSize=10;strokeColor=#555555;strokeWidth=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p8" target="p13"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p29" value="&lt;b&gt;Cómo leerlo&lt;/b&gt;&lt;br&gt;- Flecha A → B: A importa de B en src/main.&lt;br&gt;- Se omiten las dependencias que ya se deducen por transitividad (por ejemplo, core.usecase también importa core.domain y core.exception directamente), salvo core.usecase → core.port.in, que se muestra porque los casos de uso implementan esos puertos.&lt;br&gt;- core no depende de Spring: solo java.*, reactor-core, jackson y networknt.&lt;br&gt;- Sin ciclos entre paquetes.&lt;br&gt;- A vigilar: core.repository depende de core.port.in (BatchAcceptedResult)." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;spacing=8;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="1260" y="50" width="360" height="330" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>