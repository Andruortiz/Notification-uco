      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket{job=\"notification-service\",uri=\"/notifications\",method=\"POST\",status=\"202\"}[$__rate_interval])))",
          "legendFormat": "p95",
          "editorMode": "code",
          "range": true
        }
      ]
